{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bagart/telegram-bot-summarizer-module",
    "description": "Chat summarizer module for the Telegram bot platform: message collection, scheduled LLM digests and an in-chat admin panel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "telegram",
        "tg-bot",
        "telegram-bot",
        "bot-platform",
        "summarizer",
        "digest",
        "llm",
        "module"
    ],
    "authors": [
        {
            "name": "BAGArt (Artur Baltaev)",
            "email": "baltaev.artur+ask@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "bagart/telegram-bot-lib": "*",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "BAGArt\\TelegramBotSummarizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BAGArt\\TelegramBotSummarizer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php ../../../vendor/bin/phpunit --testsuite SummarizerModule"
        ]
    }
}
